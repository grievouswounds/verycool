# Local Nix commands require no .env file. These are optional interactive overrides only.
AQUA_LOG_LEVEL=info
AQUA_STATE_DIR=.data

# Optional authenticated 1inch spot-price integration. Quotes and transaction preparation do not require it.
# ONEINCH_API_KEY=
ONEINCH_BASE_URL=https://api.1inch.com
ONEINCH_DEFAULT_CURRENCY=USD

# Public Ethereum Sepolia contracts. These are already deployed; `bun scripts/deploy-public-chain.ts`
# reuses them and only writes `.data/runtime-manifest.production.json`.
AQUA_CONTRACT_AQUA=0x1111113ccf1426a8e30e2bff5e005d929bf6a90a
AQUA_CONTRACT_AQUA_SWAP_ROUTER=0x07b3475bbdb0389c21640b1334eff6a41970136b
AQUA_CONTRACT_LIMIT_SWAP_ROUTER=0xed9275955c0085a322c3b26735beb25cc21171f9
AQUA_CONTRACT_INTENT_CONTROLLER=0xbae91f21b2bf19013af494b107d9e0f8731c707a
AQUA_CONTRACT_ORDER_VAULT_FACTORY=0x90da9256755b496609dc0162a8cef413f8742d09
AQUA_CONTRACT_BOUNDED_MATCHER=0x1062b3da82e21b55be9d7658ed2557b9021ddc52
AQUA_CONTRACT_TOKEN_A=0x019799b067422517212ce754f96d4faa6cc6a090
AQUA_CONTRACT_TOKEN_B=0x0bb3844e65962a303bc4cabdd4b742a324f2f570
AQUA_CONTRACT_WETH=0xfFf9976782d46CC05630D1f6eBAb18b2324d6B14

# Signing material for the hosted env signer. Never commit real keys.
# AQUA_AGENT_KEY=
# AQUA_FACILITATOR_KEY=
# AQUA_KEEPER_KEY=
# PASETO_V4_SECRET_KEY=
# DATABASE_URL=
