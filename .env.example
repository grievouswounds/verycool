# Local Nix commands require no .env file. These are optional interactive overrides only.
AQUA_LOG_LEVEL=info
AQUA_STATE_DIR=.data

# Optional authenticated 1inch spot-price integration. Quotes and transaction preparation do not require it.
# ONEINCH_API_KEY=
ONEINCH_BASE_URL=https://api.1inch.com
ONEINCH_DEFAULT_CURRENCY=USD

# Sepolia live demo. Copy to .env and set a funded deployer key. Never commit a real key.
# AQUA_SEPOLIA_RPC_URL=https://eth-sepolia-testnet.api.pocket.network
# AQUA_SEPOLIA_PRIVATE_KEY=
# AQUA_SEPOLIA_DEPLOYER_ADDRESS=
