{
  "name": "1inch-price-server",
  "version": "1.0.0",
  "description": "Simple TypeScript API server that returns spot prices for tokens via the 1inch Spot Price API and Token API",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts"
  },
  "dependencies": {
    "@1inch/aqua-sdk": "^0.3.1",
    "@1inch/swap-vm-sdk": "^0.4.1",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
